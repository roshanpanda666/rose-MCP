# ROSE MCP server (streamable HTTP on 127.0.0.1:8765, auth required). Starts at login.
# Install:  cp deploy/rose.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#           systemctl --user enable --now rose
[Unit]
Description=ROSE MCP server (HTTP, auth required)
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/rose serve
Environment=DISPLAY=:0
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
