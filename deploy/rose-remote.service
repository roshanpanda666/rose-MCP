# systemd user service for ROSE remote access (quick tunnel + HTTP server, auth enforced).
# Install:  cp deploy/rose-remote.service ~/.config/systemd/user/ && systemctl --user daemon-reload
# Start:    systemctl --user start rose-remote        (enable --now to also start at login)
# URL:      cat ~/rose/public_url.txt                  (changes on every restart with a quick tunnel)
# Stop:     systemctl --user stop rose-remote
[Unit]
Description=ROSE MCP remote access (Cloudflare quick tunnel)
After=network-online.target graphical-session.target

[Service]
ExecStart=/home/roshan/0x/projects/rose-MCP/scripts/rose-remote.sh
Environment=PATH=/home/roshan/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
